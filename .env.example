# EXAMPLE ENVIRONMENT CONFIGURATION
# Copy this file to .env and modify the values for your setup

# Application secret - MUST be changed for production
SECRET_KEY=change-this-to-a-random-secret-key

# PostgreSQL connection (REQUIRED - these are the primary variables the app uses)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_database_name
PG_USERNAME=your_username
PG_PASSWORD=your_password

# Flask runtime settings
FLASK_DEBUG=0
APP_HOST=127.0.0.1
APP_PORT=5000

# Admin user creation (optional)
# Set to 1 to automatically create admin user on first run
CREATE_DEFAULT_ADMIN=1
DEFAULT_ADMIN_PASSWORD=change-this-password

# Legacy/Docker environment variables (kept for compatibility)
POSTGRES_HOST=localhost
POSTGRES_DB=sync_db
POSTGRES_USER=migration_user
POSTGRES_PASSWORD=StrongPassword123
POSTGRES_PORT=5432
POSTGRES_SCHEMA=CompanyDB

# ClickHouse connection (required for ClickHouse discovery and uploads)
# These values are referenced by the application as CLICKHOUSE_HOST/PORT/USER/PASSWORD
# Do NOT leave these empty if you plan to use ClickHouse as a target from the upload UI
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Application Configuration
FLASK_ENV=production
HYBRID_SYNC_BATCH_SIZE=10000

# Email Notification Settings (Optional)
# Configure these if you want email notifications for sync status
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=sql-pg-sync@your-company.com

# Slack Notification Settings (Optional)
# Configure this if you want Slack notifications for sync status
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# pgAdmin Configuration (if using pgAdmin service)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Logging Level
LOG_LEVEL=INFO