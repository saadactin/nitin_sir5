# ============================================
# HANA to ClickHouse Migration Configuration
# ============================================
# ADD THESE VARIABLES TO YOUR EXISTING .env FILE
# Do NOT replace your existing .env variables - just ADD these new ones
# Replace all placeholder values with your actual HANA credentials

# ============================================
# SAP HANA Configuration (NEW - ADD TO YOUR .env)
# ============================================
# HANA server IP address or hostname
HANA_HOST=192.168.16.62

# HANA port (default: 30015)
HANA_PORT=30015

# HANA username
HANA_USERNAME=your_hana_username

# HANA password
HANA_PASSWORD=your_hana_password

# Optional: HANA database name (if applicable)
# HANA_DATABASE=SYSTEMDB

# ============================================
# ClickHouse Configuration
# ============================================
# ClickHouse server IP address or hostname
CLICKHOUSE_HOST=localhost

# ClickHouse native port (default: 9000)
# Use 9000 for native protocol, 8123 for HTTP
CLICKHOUSE_PORT=9000

# ClickHouse username (default: 'default')
CLICKHOUSE_USER=default

# ClickHouse password (empty string for no password)
CLICKHOUSE_PASSWORD=

# ClickHouse database name where migrated data will be stored
CLICKHOUSE_DATABASE=hana_migrated

# ============================================
# Migration Settings (Optional)
# ============================================
# Batch size for data migration (rows per batch)
MIGRATION_BATCH_SIZE=10000

# Timeout settings (seconds)
# HANA_CONNECTION_TIMEOUT=30
# CLICKHOUSE_CONNECTION_TIMEOUT=30

# ============================================
# NOTES:
# ============================================
# 1. For HANA connections through VPN:
#    - Make sure VPN is connected before running migration
#    - Verify HANA port 30015 is accessible (ping won't work, but telnet will)
#    - Use: telnet 192.168.16.62 30015
#
# 2. For ClickHouse:
#    - Ensure ClickHouse server is running
#    - Check firewall allows connection on port 9000 (native) or 8123 (HTTP)
#    - Verify credentials are correct
#
# 3. Test connectivity:
#    - HANA: Use SAP HANA Studio or hdbsql command line tool
#    - ClickHouse: Use clickhouse-client or HTTP interface
#
# 4. Security:
#    - Never commit .env file to version control
#    - Use strong passwords
#    - Consider using SSL/TLS for production environments

